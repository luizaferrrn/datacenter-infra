# ============================================
# PLANTILLA de variables de entorno
# Copiar a .env y reemplazar cada "cambiar_esto"
# NUNCA subir el archivo .env real a Git
# ============================================

# --- Aplicación Next.js ---
NODE_ENV=production
PORT=3000

# --- PostgreSQL / Patroni ---
POSTGRES_USER=cambiar_esto
POSTGRES_SUPERUSER_PASSWORD=cambiar_esto
POSTGRES_DB=formulario
REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=cambiar_esto
PATRONI_SCOPE=formulario-cluster

# Conexión de la app: siempre a HAProxy (puerto 5000), nunca a un nodo fijo
DATABASE_URL=postgres://USUARIO:CLAVE@haproxy:5000/formulario

# --- etcd ---
ETCD_CLUSTER_TOKEN=cambiar_esto

# --- Redis y Sentinel ---
REDIS_PASSWORD=cambiar_esto
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379

# --- Monitoreo ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar_esto

# --- Backups ---
BACKUP_DIR=/home/ggccsa/datacenter-infra/backups
BACKUP_RETENTION_DAYS=7